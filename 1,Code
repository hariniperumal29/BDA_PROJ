# DATA SET CLEANING
from pyspark.sql import functions as F

# Read CSV with UTF-8 encoding
raw = spark.read.csv(
    CSV_PATH,
    header=True,
    #allows multiple line
    multiLine=True,
    escape='"',
    encoding="UTF-8"
)

print("Columns in dataset:")
print(raw.columns)

# Select required columns [Name,Address,Location,Rate,votes,Cost,Dish]
df = raw.select(
    F.trim(F.col("name")).alias("name"),
    F.trim(F.col("address")).alias("address"),
    F.trim(F.col("location")).alias("area"),
    F.col("rest_type"),
    F.col("dish_liked"),
    F.col("cuisines"),
    F.col("rate"),
    F.col("votes"),
    F.col("approx_cost(for two people)").alias("cost")
)

# Extract numeric rating [containg raiting in format 4.5/5 so extracting --> 4.5 only
df = df.withColumn(
    "rating",
    F.regexp_extract(
        F.col("rate"),
        r"^(\d+(?:\.\d+)?)",
        1
    ).cast("double")
)

# Convert votes and cost into numeric values
df = df.withColumn(
    "votes",
    F.regexp_replace(F.col("votes"), ",", "").cast("int")
)

# removing cost [,] making it int
df = df.withColumn(
    "cost",
    F.regexp_replace(F.col("cost"), ",", "").cast("int")
)

# Remove missing and invalid records
df = df.filter(
    F.col("rating").isNotNull() &
    F.col("votes").isNotNull() &
    F.col("name").isNotNull() &
    F.col("area").isNotNull() &
    (F.length(F.trim(F.col("name"))) > 0) &
    (F.length(F.trim(F.col("area"))) > 0) &
    (F.col("rating") >= 1) &
    (F.col("rating") <= 5) &
    (F.col("votes") >= 50)
)

# Remove duplicate restaurants
df = df.dropDuplicates(["name", "address"])

# Generate unique restaurant ID
df = df.withColumn(
    "rid",
    F.monotonically_increasing_id()
)

# Display cleaned dataset
print("Cleaned restaurant count:", df.count())

df.select(
    "name",
    "area",
    "rating",
    "votes",
    "cost"
).show(20, truncate=False)
