Labelling feedback
This cell performs sentiment labelling based on customer review ratings. Ratings of 4 and above are labelled Positive, rating 3 is labelled Neutral, and ratings below 3 are labelled Negative.

Next, we clean the review text by converting it to lowercase, removing unwanted words and special characters, and removing extra spaces. We also remove reviews with 10 or fewer characters. Finally, we display the sentiment distribution and sample labelled reviews.
# ==========================================
# CELL 10: SENTIMENT LABEL CREATION
# ==========================================

from pyspark.sql import functions as F

# Assign sentiment based on review rating
sentiment_df = (
    individual_reviews
    .withColumn(
        "sentiment",
        F.when(F.col("review_rating") >= 4, "Positive")
         .when(F.col("review_rating") == 3, "Neutral")
         .otherwise("Negative")
    )
)

# Clean review text
sentiment_df = sentiment_df.withColumn(
    "clean_review",
    F.lower(F.col("review_text"))
)

sentiment_df = sentiment_df.withColumn(
    "clean_review",
    F.regexp_replace(
        F.col("clean_review"),
        r"rated|\\n|[^a-zA-Z\s]",
        " "
    )
)

sentiment_df = sentiment_df.withColumn(
    "clean_review",
    F.regexp_replace(F.col("clean_review"), r"\s+", " ")
)

# Remove empty reviews
sentiment_df = sentiment_df.filter(
    F.length(F.trim(F.col("clean_review"))) > 10
)

# Display sentiment distribution
print("Sentiment distribution:")

sentiment_df.groupBy("sentiment") \
    .count() \
    .orderBy("sentiment") \
    .show()

print("Sample labelled reviews:")

sentiment_df.select(
    "review_rating",
    "sentiment",
    "clean_review"
).show(10, truncate=100)
